* text=auto
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.lock text eol=lf
.gitattributes text eol=lf
# Spec originals keep their exact bytes; manifest hashes must stay stable.
spec/*.pdf binary
spec/*.md -text
# Byte-exact test inputs; generators and tests compare raw bytes.
tests/fixtures/**/*.txt text eol=lf
